# Copy this file to src/main/docker/everycent.env and fill in real values.
# Do not commit the filled file.

# Application port. With Docker host networking, this port is exposed directly on the host.
APP_PORT=8080
APP_BASE_URL=http://YOUR_SERVER_IP:8080

# Physical MySQL server. Do not use localhost unless MySQL is inside the same container.
DB_HOST=YOUR_DB_SERVER_IP
DB_PORT=3306
DB_NAME=everycent
DB_USERNAME=everycent
DB_PASSWORD=CHANGE_ME

# Generate with:
# openssl rand -base64 64
JWT_BASE64_SECRET=CHANGE_ME_TO_BASE64_SECRET

# JVM/runtime options.
JAVA_OPTS=
JHIPSTER_SLEEP=0
SPRING_PROFILES_ACTIVE=prod,api-docs
DEV_SPRING_PROFILES_ACTIVE=dev,api-docs
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# LLM configuration. Keep the real API key only in everycent.env.
APP_LLM_ENABLED=true
APP_LLM_PROVIDER=openai-compatible
APP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_LLM_API_KEY=CHANGE_ME
APP_LLM_MODEL=qwen3.6-flash
APP_LLM_TIMEOUT_SECONDS=20
APP_LLM_MIN_CONFIDENCE=0.70
APP_LLM_MAX_INPUT_LENGTH=500

# Embedding configuration. Keep the real embedding API key only in everycent.env.
APP_EMBEDDING_PROVIDER=openai-compatible
APP_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_EMBEDDING_API_KEY=CHANGE_ME
APP_EMBEDDING_MODEL=text-embedding-v3
APP_EMBEDDING_DIMENSION=1024
APP_EMBEDDING_TIMEOUT_SECONDS=20

# Local vector store configuration.
APP_VECTOR_STORE_PROVIDER=qdrant
APP_VECTOR_STORE_BASE_URL=http://127.0.0.1:6333
# Used only by docker-dev.yml. The dev container reaches host services through host.docker.internal.
DEV_VECTOR_STORE_BASE_URL=http://host.docker.internal:6333
APP_VECTOR_STORE_MEMORY_COLLECTION=everycent_ai_memory
APP_VECTOR_STORE_ROLE_KNOWLEDGE_COLLECTION=everycent_ai_role_knowledge
APP_VECTOR_STORE_TIMEOUT_SECONDS=10
