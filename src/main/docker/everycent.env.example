# Copy this file to src/main/docker/everycent.env and fill in real values.
# Do not commit the filled file.

# Application port. With Docker host networking, this port is exposed directly on the host.
APP_PORT=8080
APP_BASE_URL=http://YOUR_SERVER_IP:8080

# Physical MySQL server. Do not use localhost unless MySQL is inside the same container.
DB_HOST=YOUR_DB_SERVER_IP
DB_PORT=3306
DB_NAME=everycent
DB_USERNAME=everycent
DB_PASSWORD=CHANGE_ME

# Generate with:
# openssl rand -base64 64
JWT_BASE64_SECRET=CHANGE_ME_TO_BASE64_SECRET

# JVM/runtime options.
JAVA_OPTS=
JHIPSTER_SLEEP=0
SPRING_PROFILES_ACTIVE=prod,api-docs
DEV_SPRING_PROFILES_ACTIVE=dev,api-docs
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# LLM configuration. Keep the real API key only in everycent.env.
APP_LLM_ENABLED=true
APP_LLM_PROVIDER=openai-compatible
APP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_LLM_API_KEY=CHANGE_ME
APP_LLM_MODEL=qwen3.6-flash
APP_LLM_TIMEOUT_SECONDS=20
APP_LLM_MIN_CONFIDENCE=0.70
APP_LLM_MAX_INPUT_LENGTH=500
